{%- comment -%}
  mq-withdrawal-link: App embed — places the withdrawal link on every page (07 §8).
  Label per store language from shop.metafields["$app:mosaiq"].withdrawal.value.
  Links to /apps/mosaiq/withdraw (guest form, no login).
  Places in the first <footer> element; if that does not exist, a fixed
  small link at the bottom left. Always visible, on every page.
{%- endcomment -%}

{%- liquid
  assign withdrawal = shop.metafields["$app:mosaiq"].withdrawal.value
  assign locale = request.locale.iso_code
  assign link_label = withdrawal.labels[locale].link
  assign is_de = false
  if locale == "de"
    assign is_de = true
  endif
-%}

{%- if withdrawal and link_label -%}
  <div class="mq-withdrawal-link" data-mq-withdrawal-link>
    <a href="{{ withdrawal.url | default: '/apps/mosaiq/withdraw' }}" class="mq-withdrawal-link__anchor">
      {{ link_label }}
    </a>
  </div>

  <style>
    .mq-withdrawal-link {
      font-size: 11px;
      margin-top: 8px;
    }
    .mq-withdrawal-link__anchor {
      text-decoration: underline;
      color: inherit;
      opacity: 0.7;
    }
    .mq-withdrawal-link__anchor:hover {
      opacity: 1;
    }
    /* Fixed bottom-left fallback when no footer exists */
    body:not(:has(footer)) .mq-withdrawal-link {
      position: fixed;
      bottom: 8px;
      left: 8px;
      z-index: 9999;
      background: rgba(255, 255, 255, 0.9);
      padding: 4px 8px;
      border-radius: 4px;
    }
  </style>

  <script>
    (function () {
      var el = document.querySelector('[data-mq-withdrawal-link]');
      if (!el) return;
      var footer = document.querySelector('footer');
      if (footer) {
        footer.appendChild(el);
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "mq-withdrawal-link",
  "target": "body",
  "settings": []
}
{% endschema %}
