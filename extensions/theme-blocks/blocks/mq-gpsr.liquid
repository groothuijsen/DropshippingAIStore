{%- comment -%}
  mq-gpsr: GPSR compliance information block (art. 19).
  Reads from product.metafields["$app:mosaiq"].gpsr.value.
  Displays: manufacturer, EU responsible person, product identifier, warnings.
  Renders nothing if metafield is missing (F06 criterion 2).
{%- endcomment -%}

{%- liquid
  assign gpsr = product.metafields["$app:mosaiq"].gpsr.value
-%}

{%- if gpsr -%}
  <div class="mq-gpsr">
    <h2 class="mq-gpsr__title">{{ 'gpsr.heading' | t | default: 'Product information' }}</h2>

    {%- if gpsr.manufacturer_name -%}
      <div class="mq-gpsr__section">
        <h3 class="mq-gpsr__subtitle">{{ 'gpsr.manufacturer' | t | default: 'Manufacturer' }}</h3>
        <p class="mq-gpsr__text">
          {{ gpsr.manufacturer_name }}<br>
          {{ gpsr.manufacturer_address }}<br>
          {{ gpsr.manufacturer_email }}
        </p>
      </div>
    {%- endif -%}

    {%- if gpsr.eu_rp_name -%}
      <div class="mq-gpsr__section">
        <h3 class="mq-gpsr__subtitle">{{ 'gpsr.responsible_person' | t | default: 'Responsible person' }}</h3>
        <p class="mq-gpsr__text">
          {{ gpsr.eu_rp_name }}<br>
          {{ gpsr.eu_rp_address }}<br>
          {{ gpsr.eu_rp_email }}
        </p>
      </div>
    {%- endif -%}

    {%- if gpsr.product_identifier -%}
      <div class="mq-gpsr__section">
        <h3 class="mq-gpsr__subtitle">{{ 'gpsr.product_identifier' | t | default: 'Product identifier' }}</h3>
        <p class="mq-gpsr__text">{{ gpsr.product_identifier }}</p>
      </div>
    {%- endif -%}

    {%- if gpsr.warnings -%}
      <div class="mq-gpsr__section mq-gpsr__warnings">
        <h3 class="mq-gpsr__subtitle">{{ 'gpsr.safety_warnings' | t | default: 'Safety warnings' }}</h3>
        <p class="mq-gpsr__text">{{ gpsr.warnings }}</p>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "mq-gpsr",
  "target": "section",
  "templates": ["product"],
  "settings": []
}
{% endschema %}
